<?xml version="1.0" encoding="UTF-8"?>
<!--
  ROS 2 on this robot stays on this machine. This is the complete Fast DDS
  setup, used with ROS_AUTOMATIC_DISCOVERY_RANGE=SYSTEM_DEFAULT so ROS adds
  nothing of its own: UDP pinned to 127.0.0.1 plus shared memory, Fast DDS's
  default discovery on that interface. It is exactly what Humble's
  ROS_LOCALHOST_ONLY=1 built inside rmw_fastrtps (participant.cpp, humble).
  Loaded through FASTRTPS_DEFAULT_PROFILES_FILE by every ROS process: session
  scripts, the image's ENV, and robot_app's env file.

  Why not Jazzy's ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST:
  - It does not pin the transport: nodes advertise every address the machine
    has at startup, so after a Wi-Fi/IP change nodes started before it can
    no longer be reached (seen on the A2 Pi 5, 2026-10-23).
  - It discovers by unicast to a range of local ports. Measured on the A2 Pi 5
    (2026-10-24), Nav2-style bring-ups with 20 other ROS processes running:
    median 14.3 s with LOCALHOST, 8.1 s with this profile.
  - It is applied after this file is loaded and adds its own SHM and UDP
    transports, so combining the two gives a mixed setup: the only one that
    lost a service reply in that test (1 in 50), the failure that left Nav2
    half-started on the robot.
  See JAZZY_MIGRATION.md, "ROS traffic pinned to 127.0.0.1".
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_localhost</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="localhost_only" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>udp_localhost</transport_id>
        <transport_id>shm</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>

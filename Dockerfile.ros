# BonicBot A2 — bonicbot_ros image.
#
# Unlike M1, which splits hardware and nav into two containers, A2 bundles both
# into this single image: the RPi4 does not have the headroom to justify a
# second container's overhead. The src/hardware vs src/nav separation is still
# enforced at the source level (they only ever talk over ROS2 topics).
#
# The sim package is deliberately NOT built here — Gazebo never runs on the robot.

FROM ros:humble-ros-base

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-humble-ros2-control \
      ros-humble-ros2-controllers \
      ros-humble-controller-manager \
      ros-humble-diff-drive-controller \
      ros-humble-joint-state-broadcaster \
      ros-humble-position-controllers \
      ros-humble-twist-mux \
      ros-humble-robot-state-publisher \
      ros-humble-xacro \
      ros-humble-navigation2 \
      ros-humble-nav2-bringup \
      ros-humble-slam-toolbox \
      ros-humble-robot-localization \
      ros-humble-rplidar-ros \
      ros-humble-v4l2-camera \
      ros-humble-image-transport-plugins \
      ros-humble-joy \
      ros-humble-teleop-twist-joy \
      ros-humble-cv-bridge \
      python3-colcon-common-extensions \
      python3-opencv \
      v4l-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ws

# Copy manifests first so dependency resolution is cached independently of
# source edits — a code change should not re-run rosdep.
COPY src/hardware/bonicbot_a2_hardware/package.xml    src/hardware/bonicbot_a2_hardware/
COPY src/nav/bonicbot_a2_description/package.xml      src/nav/bonicbot_a2_description/
COPY src/nav/bonicbot_a2_nav/package.xml              src/nav/bonicbot_a2_nav/

RUN apt-get update \
    && rosdep install --from-paths src --ignore-src -r -y \
       --skip-keys "bonicbot_a2_description bonicbot_a2_hardware bonicbot_a2_nav" \
    && rm -rf /var/lib/apt/lists/*

# TF2 0.25.23 MUST NOT SHIP. It deadlocks Nav2's TF listener, and nothing says
# so: no log line, no crash, every node still running — the controller's
# map -> odom just stops advancing and every goal fails.
#
# A has never had it, and only by luck: 2.3.1 carries tf2 0.25.22 because the
# apt layers above were cached on 2026-09-09, before packages.ros.org/ros2
# started serving 0.25.23. Nothing here pins a version, so the first build that
# misses that cache would install it. S1 did (bonicos-s1-ros 1.1.0, built a
# month later) and froze within minutes of every navigation session,
# 2026-10-07; bonicOS-s1-ros/Dockerfile.ros has the full account.
#
# Upstream: ros2/geometry2 #966 introduced it, #982 fixes it and is 0.25.24,
# #992 is the report. The fix is in libtf2.so alone.
#
# So, the same step as S1's: if this image came out with a tf2 in the broken
# range, take geometry2 — and only geometry2 — from ros2-testing, then drop
# that source again. Older than 0.25.23 predates the bug and is left exactly as
# it is, so this changes nothing while the cache holds; once the main repo
# carries the fix the range no longer matches either. And the build ends by
# refusing a tf2 in the broken range, whatever happened above.
RUN set -eu; \
    tf2_broken() { \
      v="$(dpkg-query -W -f='${Version}' ros-humble-tf2)"; \
      dpkg --compare-versions "$v" ge 0.25.23 \
        && dpkg --compare-versions "$v" lt 0.25.24; \
    }; \
    if tf2_broken; then \
      sed -e 's#packages.ros.org/ros2/ubuntu#packages.ros.org/ros2-testing/ubuntu#' \
          -e 's#^Types:.*#Types: deb#' \
          /etc/apt/sources.list.d/ros2.sources \
          > /etc/apt/sources.list.d/ros2-testing.sources; \
      apt-get update; \
      apt-get install -y --no-install-recommends --only-upgrade \
        ros-humble-geometry2 \
        ros-humble-tf2 \
        ros-humble-tf2-bullet \
        ros-humble-tf2-eigen \
        ros-humble-tf2-eigen-kdl \
        ros-humble-tf2-geometry-msgs \
        ros-humble-tf2-kdl \
        ros-humble-tf2-msgs \
        ros-humble-tf2-py \
        ros-humble-tf2-ros \
        ros-humble-tf2-ros-py \
        ros-humble-tf2-sensor-msgs \
        ros-humble-tf2-tools; \
      rm -f /etc/apt/sources.list.d/ros2-testing.sources; \
      rm -rf /var/lib/apt/lists/*; \
    fi; \
    if tf2_broken; then \
      echo "ros-humble-tf2 is $(dpkg-query -W -f='${Version}' ros-humble-tf2):" \
           "the release that deadlocks Nav2's TF listener, and no fixed one" \
           "could be installed. Not building an image that cannot navigate." >&2; \
      exit 1; \
    fi; \
    dpkg-query -W -f='tf2 in this image: ${Package} ${Version}\n' \
      ros-humble-tf2 ros-humble-tf2-ros

COPY src/hardware/ src/hardware/
COPY src/nav/      src/nav/

RUN . /opt/ros/humble/setup.sh \
    && colcon build \
       --packages-select bonicbot_a2_hardware bonicbot_a2_description bonicbot_a2_nav \
       --cmake-args -DCMAKE_BUILD_TYPE=Release

# The one authoritative statement of what this ROS image is.
#
# WHY THIS EXISTS. The tag alone was never enough. `bonicos:0.1.2` recorded
# `ros_image=autobonics/bonicbot-a2-ros:2.0.0`, and that tag mapped to no
# commit anywhere — so "what ROS stack is this robot running?" could only be
# answered by opening the image. It took a camera that would not stream on real
# hardware to discover that 2.0.0 predated the v4l2_camera → camera_ros switch.
#
# TWO LINES, and the split is the same contract as robot_app's
# /app/version.txt (DEPLOYMENT_ARCHITECTURE.md §2.6):
#
#   line 1   the version, ALONE. Anything appended makes this image report a
#            version matching no tag that was ever published.
#   line 2+  key=value build facts. `commit` is the one that matters: it is
#            what makes a tag traceable back to source.
#
# Written from build args by build-image.sh, never by hand — a version someone
# types is a version that goes stale.
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
# Keys are UNPREFIXED here — this file belongs to the ROS image, so `distro=`
# is unambiguous in context. robot_app prefixes them with `ros_` when it merges
# them into build_info(), so `distro` surfaces as `ros_distro`. Writing
# `ros_distro=` here would come back as `ros_ros_distro`.
RUN printf '%s\ncommit=%s\nbuilt=%s\ndistro=%s\n' \
      "${VERSION}" "${GIT_COMMIT}" "${BUILD_DATE}" "${ROS_DISTRO:-humble}" \
      > /ws/version.txt

# Maps live on a volume so they survive image rebuilds.
ENV BONICBOT_MAPS_DIR=/maps
RUN mkdir -p /maps

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "bonicbot_a2_hardware", "hardware.launch.py"]

# BonicBot A2 — bonicbot_ros image.
#
# Unlike M1, which splits hardware and nav into two containers, A2 bundles both
# into this single image: the RPi4 does not have the headroom to justify a
# second container's overhead. The src/hardware vs src/nav separation is still
# enforced at the source level (they only ever talk over ROS2 topics).
#
# The sim package is deliberately NOT built here — Gazebo never runs on the robot.

FROM ros:jazzy-ros-base

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-jazzy-ros2-control \
      ros-jazzy-ros2-controllers \
      ros-jazzy-controller-manager \
      ros-jazzy-diff-drive-controller \
      ros-jazzy-joint-state-broadcaster \
      ros-jazzy-position-controllers \
      ros-jazzy-twist-mux \
      ros-jazzy-topic-tools \
      ros-jazzy-robot-state-publisher \
      ros-jazzy-xacro \
      ros-jazzy-navigation2 \
      ros-jazzy-nav2-bringup \
      ros-jazzy-slam-toolbox \
      ros-jazzy-robot-localization \
      ros-jazzy-image-transport-plugins \
      ros-jazzy-joy \
      ros-jazzy-teleop-twist-joy \
      ros-jazzy-cv-bridge \
      python3-colcon-common-extensions \
      python3-colcon-meson \
      python3-vcstool \
      meson \
      ninja-build \
      pkg-config \
      python3-jinja2 \
      python3-ply \
      python3-yaml \
      libyaml-dev \
      libssl-dev \
      openssl \
      libudev-dev \
      nlohmann-json3-dev \
      python3-opencv \
      v4l-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ws

# Source dependencies from external.repos, imported BEFORE rosdep so rosdep
# sees them as workspace packages and does not install their apt versions.
# Today that is rplidar_ros (Jazzy's apt build bundles Slamtec's SDK 1.12,
# which cannot drive the RPLIDAR C1), and Raspberry Pi's libcamera fork with
# camera_ros (upstream libcamera finds no camera on a Pi 5). See
# external.repos. Pinned to commits, so a rebuild cannot silently pick up
# different code. The meson/ninja/lib*-dev packages above are libcamera's
# build dependencies; libpisp (its Pi 5 ISP library) is a meson subproject
# fetched at configure time.
COPY external.repos /ws/external.repos
RUN mkdir -p src/external && vcs import src/external < external.repos

# Copy manifests first so dependency resolution is cached independently of
# source edits — a code change should not re-run rosdep.
COPY src/hardware/bonicbot_a2_hardware/package.xml    src/hardware/bonicbot_a2_hardware/
COPY src/nav/bonicbot_a2_description/package.xml      src/nav/bonicbot_a2_description/
COPY src/nav/bonicbot_a2_nav/package.xml              src/nav/bonicbot_a2_nav/

RUN apt-get update \
    && rosdep install --from-paths src --ignore-src -r -y \
       --skip-keys "bonicbot_a2_description bonicbot_a2_hardware bonicbot_a2_nav libcamera" \
    && rm -rf /var/lib/apt/lists/*

# TF2 / NAV2 DEADLOCK — the Humble image's ros2-testing workaround is gone, on
# purpose. Humble shipped geometry2's waitForTransform change (#966) on its own
# in tf2 0.25.23, which deadlocked Nav2's TF listener, and the fix (#982) only
# followed in 0.25.24 — hence the version check this file used to carry.
# Jazzy received both in the SAME release, 0.36.23, so no Jazzy tf2 has the
# bug without the fix and there is no broken range to guard against.
# bonicOS-s1-ros/Dockerfile.ros has the full account of the Humble incident.

COPY src/hardware/ src/hardware/
COPY src/nav/      src/nav/

RUN . /opt/ros/jazzy/setup.sh \
    && colcon build \
       --packages-select rplidar_ros libcamera camera_ros \
         bonicbot_a2_hardware bonicbot_a2_description bonicbot_a2_nav \
       --cmake-args -DCMAKE_BUILD_TYPE=Release \
       --meson-args \
         -Dpipelines=rpi/vc4,rpi/pisp -Dipas=rpi/vc4,rpi/pisp \
         -Dv4l2=disabled -Dgstreamer=disabled -Dpycamera=disabled \
         -Drpi-awb-nn=disabled -Dcam=disabled -Dqcam=disabled \
         -Dlc-compliance=disabled -Ddocumentation=disabled -Dtest=false

# The one authoritative statement of what this ROS image is.
#
# WHY THIS EXISTS. The tag alone was never enough. `bonicos:0.1.2` recorded
# `ros_image=autobonics/bonicbot-a2-ros:2.0.0`, and that tag mapped to no
# commit anywhere — so "what ROS stack is this robot running?" could only be
# answered by opening the image. It took a camera that would not stream on real
# hardware to discover that 2.0.0 predated the v4l2_camera → camera_ros switch.
#
# TWO LINES, and the split is the same contract as robot_app's
# /app/version.txt (DEPLOYMENT_ARCHITECTURE.md §2.6):
#
#   line 1   the version, ALONE. Anything appended makes this image report a
#            version matching no tag that was ever published.
#   line 2+  key=value build facts. `commit` is the one that matters: it is
#            what makes a tag traceable back to source.
#
# Written from build args by build-image.sh, never by hand — a version someone
# types is a version that goes stale.
ARG VERSION=dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
# Keys are UNPREFIXED here — this file belongs to the ROS image, so `distro=`
# is unambiguous in context. robot_app prefixes them with `ros_` when it merges
# them into build_info(), so `distro` surfaces as `ros_distro`. Writing
# `ros_distro=` here would come back as `ros_ros_distro`.
RUN printf '%s\ncommit=%s\nbuilt=%s\ndistro=%s\n' \
      "${VERSION}" "${GIT_COMMIT}" "${BUILD_DATE}" "${ROS_DISTRO:-jazzy}" \
      > /ws/version.txt

# ROS traffic stays on this machine: the localhost discovery range plus a
# transport pinned to 127.0.0.1 (config/fastdds_localhost.xml). In the image,
# not the compose file, so every process started from it — the stack,
# robot_app's image built on top, `docker exec ... ros2` — inherits it.
COPY config/fastdds_localhost.xml /ws/config/fastdds_localhost.xml
ENV ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST \
    FASTRTPS_DEFAULT_PROFILES_FILE=/ws/config/fastdds_localhost.xml

# Maps live on a volume so they survive image rebuilds.
ENV BONICBOT_MAPS_DIR=/maps
RUN mkdir -p /maps

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "bonicbot_a2_hardware", "hardware.launch.py"]

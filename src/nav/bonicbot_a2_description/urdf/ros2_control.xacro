<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:if value="$(arg sim_mode)">
    <!-- SIMULATION -->
    <ros2_control name="GazeboSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-30</param>
          <param name="max">30</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-30</param>
          <param name="max">30</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      
      <!-- Humanoid Joint Interfaces -->
      <!-- Shoulders -->
      <joint name="left_shoulder_pitch_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_shoulder_pitch_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      
      <!-- Elbows -->
      <joint name="left_elbow_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_elbow_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      
      <!-- Neck -->
      <joint name="neck_yaw_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      
      <!-- Grippers - Primary fingers -->
      <joint name="left_gripper_finger1_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_gripper_finger1_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      
      <!-- Grippers - Mimic fingers -->
      <joint name="left_gripper_finger2_joint">
        <param name="mimic">left_gripper_finger1_joint</param>
        <param name="multiplier">1</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_gripper_finger2_joint">
        <param name="mimic">right_gripper_finger1_joint</param>
        <param name="multiplier">1</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find bonicbot_a2_hardware)/config/controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

  <xacro:unless value="$(arg sim_mode)">
    <!-- REAL ROBOT HARDWARE -->
    <ros2_control name="RealRobot" type="system">
      <hardware>
        <plugin>bonicbot_a2_hardware/EspHardwareInterface</plugin>
        <param name="serial_port">/dev/esp</param>
        <param name="serial_baud">921600</param>
        <param name="encoder_cpr">$(optenv ENCODER_CPR 14040.0)</param>
        <param name="wheel_radius">$(optenv WHEEL_RADIUS 0.06)</param>   <!-- 0.12m diameter / 2. Per-robot override via bonicOS-robot-app's robot_config.yaml (hardware.wheel_radius -> config.py -> os.environ WHEEL_RADIUS). hardware.launch.py applies the SAME env var to diff_cont's own wheel_radius copy in controllers.yaml — both must move together or drive commands are silently scaled wrong. -->
        <param name="max_velocity">4.5</param>   <!-- ~43 RPM — lowered 2026-08-25, 10.47 (100 RPM) was too fast on real hardware -->
        <param name="motor_accel">0.5</param>   <!-- m/s^2 — lowered 2026-08-25 from the 1.5 default, also too aggressive on real hardware -->
      </hardware>
      <joint name="left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-10.47</param>
          <param name="max">10.47</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-10.47</param>
          <param name="max">10.47</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      
      <!-- Humanoid Joint Interfaces -->
      <!-- Shoulders -->
      <joint name="left_shoulder_pitch_joint">
        <command_interface name="position"/>
        <param name="min">-0.785</param>  <!-- -45 degrees -->
        <param name="max">3.14</param>  <!-- 180 degrees -->
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_shoulder_pitch_joint">
        <command_interface name="position"/>
        <param name="min">-0.785</param>  <!-- -45 degrees -->
        <param name="max">3.14</param>  <!-- 180 degrees -->
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      
      <!-- Elbows -->
      <!-- Firmware v2.1 (2026-09-05) re-signed the wire convention from
           -0.873..0 to 0..0.785 rad (45 degrees) — same physical travel,
           opposite sign for the same bend. See body.xacro's elbow joints for
           the matching axis flip that keeps RViz/Gazebo agreeing with hardware. -->
      <joint name="left_elbow_joint">
        <command_interface name="position"/>
        <param name="min">0</param>  <!-- 0 degrees -->
        <param name="max">0.785</param>  <!-- 45 degrees -->
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_elbow_joint">
        <command_interface name="position"/>
        <param name="min">0</param>  <!-- 0 degrees -->
        <param name="max">0.785</param>  <!-- 45 degrees -->
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      
      <!-- Neck -->
      <joint name="neck_yaw_joint">
        <command_interface name="position"/>
        <param name="min">-1.571</param>  <!-- -90 degrees -->
        <param name="max">1.571</param>  <!-- 90 degrees -->
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      
      <!-- Grippers - Primary fingers -->
      <joint name="left_gripper_finger1_joint">
        <command_interface name="position"/>
        <param name="min">-0.785</param>  <!-- -45 degrees -->
        <param name="max">1.047</param>  <!-- 60 degrees -->
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="right_gripper_finger1_joint">
        <command_interface name="position"/>
        <param name="min">-0.785</param>  <!-- -45 degrees -->
        <param name="max">1.047</param>  <!-- 60 degrees -->
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:unless>

</robot>
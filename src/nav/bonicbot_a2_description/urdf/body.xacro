<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- All properties and materials are now defined in robot_core.xacro -->



    <!-- BODY LINK -->
    <joint name="body_joint" type="fixed">
        <parent link="chassis"/>
        <child link="body"/>
        <!-- Position body on top of chassis -->
        <origin xyz="-0.013 0 ${body_joint_z_rel_chassis}" rpy="0 0 0"/>
    </joint>

    <link name="body">
        <!-- Pelvis (Bottom cylinder) -->
        <visual>
            <origin xyz="0 0 0.06" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${body_length*.3}" length="0.18"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.06" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${body_length*.3}" length="0.18"/>
            </geometry>
        </collision>

        <!-- Waist (Middle cylinder) -->
        <visual>
            <origin xyz="0 0 0.17" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${body_length * 0.2}" length="0.12"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.17" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${body_length * 0.2}" length="0.12"/>
            </geometry>
        </collision>

        <!-- Chest (Third cylinder) -->
        <visual>
            <origin xyz="0 0 0.265" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${body_length*.25}" length="0.091"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.265" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${body_length*.25}" length="0.091"/>
            </geometry>
        </collision>

        <!-- Shoulder (Cylinder connecting both arms) -->
        <visual>
            <origin xyz="0 0 0.335" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="0.04" length="${(body_width/2 + shoulder_radius + 0.01) * 2}"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.335" rpy="${pi/2} 0 0"/>
            <geometry>
                <cylinder radius="0.04" length="${(body_width/2 + shoulder_radius + 0.01) * 2}"/>
            </geometry>
        </collision>



        <!-- Custom Inertial Property (Composite of the Pelvis, Waist, Chest, and Shoulder cylinders) -->
        <inertial>
            <origin xyz="0.0 0.0 0.170963" rpy="0 0 0"/>
            <mass value="${body_mass}"/>
            <inertia ixx="0.08667" ixy="0.0" ixz="0.0" iyy="0.08667" iyz="0.0" izz="0.06533"/>
        </inertial>
    </link>

    <gazebo reference="body">
        <material>Gazebo/Grey</material>
    </gazebo>


    <!-- LEFT ARM -->
    
    <!-- Left Shoulder Pitch Joint -->
    <joint name="left_shoulder_pitch_joint" type="revolute">
        <parent link="body"/>
        <child link="left_shoulder"/>
        <origin xyz="0 ${body_width/2 + shoulder_radius+0.035} ${body_height * 0.93}" rpy="0.275 0 0"/>
        <axis xyz="0 -1 0.265"/>
        <limit lower="-0.785" upper="3.14" effort="10.0" velocity="2.0"/>
        <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <link name="left_shoulder">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${shoulder_radius}"/>
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${shoulder_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="${shoulder_mass}" radius="${shoulder_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>

    <gazebo reference="left_shoulder">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Visual-only colored mesh attached to left shoulder (converted from left-shoulder.glb) -->
    <joint name="external_left_shoulder_mesh_joint" type="fixed"> 
        <parent link="left_shoulder"/>
        <child link="external_left_shoulder_mesh_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="external_left_shoulder_mesh_link">
        <visual>
            <origin xyz="0 -0.06175 .0185" rpy="0 -0.245 -1.5708"/>
            <geometry>
                <mesh filename="package://bonicbot_a2_description/meshes/left-shoulder.obj"/>
            </geometry>
        </visual>
    </link> 
    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->


    <!-- Left Upper Arm -->
    <joint name="left_upper_arm_joint" type="fixed">
        <parent link="left_shoulder"/>
        <child link="left_upper_arm"/>
        <origin xyz="0 0 -${upper_arm_length/2}" rpy="0 0 0"/>
    </joint>

    <link name="left_upper_arm">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${upper_arm_radius}" length="${upper_arm_length}"/>
            </geometry>
            <material name="light_grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${upper_arm_radius}" length="${upper_arm_length}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${upper_arm_mass}" length="${upper_arm_length}" radius="${upper_arm_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="left_upper_arm">
        <material>Gazebo/LightGrey</material>
        <self_collide>false</self_collide>
    </gazebo>

    <!-- Left Elbow Joint -->
    <joint name="left_elbow_joint" type="revolute">
        <parent link="left_upper_arm"/>
        <child link="left_forearm"/>
        <origin xyz="0 0 -${upper_arm_length/2}" rpy="-0.235 0 0"/>
        <!-- Axis reversed on 2026-08-25. The physical elbow moved correctly
             for a given command while RViz rendered its mirror image, from the
             SAME /joint_states sample - an objective URDF-vs-hardware
             disagreement, not a matter of expectation. Gazebo agreed with RViz
             because both read this file. Fixed here rather than by re-adding
             elbow IDs (4, 11) to isServoInverted(), which would have made RViz
             match by breaking the real arm.
             Firmware v2.1 (2026-09-05) re-signed the wire convention from
             -0.873..0 to 0..0.785 rad (45 deg) - same physical travel, opposite
             sign for the same bend. Rotation(axis, angle) == Rotation(-axis,
             -angle), so to keep the physical direction unchanged under the new
             positive-angle convention the axis is negated a second time here
             (rather than re-adding a sign flip in esp_hardware_interface.cpp,
             which forwards joint values to the wire verbatim - see
             isServoInverted()), and the limit flips to 0..0.785 to match. -->
        <axis xyz="0 -0.9725 -0.2328"/>
        <limit lower="0" upper="0.785" effort="5.0" velocity="2.0"/>
        <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <link name="left_forearm">
        <visual>
            <origin xyz="0.0055 0 -${forearm_length/2}" rpy="0 -0.085 0"/>
            <geometry>
                <cylinder radius="${forearm_radius}" length="${forearm_length}"/>
            </geometry>
            <material name="light_grey"/>
        </visual>
        <collision>
            <origin xyz="0.0055  0 -${forearm_length/2}" rpy="0 -0.085 0"/>
            <geometry>
                <cylinder radius="${forearm_radius}" length="${forearm_length}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${forearm_mass}" length="${forearm_length}" radius="${forearm_radius}">
            <origin xyz="0.0055  0 -${forearm_length/2}" rpy="0 -0.085 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="left_forearm">
        <material>Gazebo/LightGrey</material>
        <self_collide>false</self_collide>
    </gazebo>

    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Visual-only colored mesh attached to left forearm (converted from left-forearm.glb)--> 
    <joint name="external_left_forearm_mesh_joint" type="fixed">
        <parent link="left_forearm"/>
        <child link="external_left_forearm_mesh_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="external_left_forearm_mesh_link">
        <visual>
            <origin xyz="0.005 -0.0125 -0.00275" rpy=".1 -0.115 1.5708"/>
            <geometry>
                <mesh filename="package://bonicbot_a2_description/meshes/left-forearm.obj"/>
            </geometry>
        </visual>y
    </link> 
    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->


    <!-- RIGHT ARM -->
    
    <!-- Right Shoulder Pitch Joint -->
    <joint name="right_shoulder_pitch_joint" type="revolute">
        <parent link="body"/>
        <child link="right_shoulder"/>
        <origin xyz="0 ${-(body_width/2 + shoulder_radius+0.035)} ${body_height * 0.93}" rpy="-0.275 0 0"/>
        <axis xyz="0 -1 -0.265"/>
        <limit lower="-0.785" upper="3.14" effort="10.0" velocity="2.0"/>
        <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <link name="right_shoulder">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${shoulder_radius}"/>
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <sphere radius="${shoulder_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="${shoulder_mass}" radius="${shoulder_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>

    <gazebo reference="right_shoulder">
        <material>Gazebo/DarkGrey</material>
    </gazebo>

    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Visual-only colored mesh attached to right shoulder (converted from right-shoulder.glb) -->
    <joint name="external_right_shoulder_mesh_joint" type="fixed">
        <parent link="right_shoulder"/>
        <child link="external_right_shoulder_mesh_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="external_right_shoulder_mesh_link">
        <visual>
        
            <origin xyz="0 0.06175 .0185" rpy="0 -0.245 1.5708"/>
            <geometry>
                <mesh filename="package://bonicbot_a2_description/meshes/right-shoulder.obj"/>
            </geometry>
        </visual>
    </link> 
    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->

    <!-- Right Upper Arm -->
    <joint name="right_upper_arm_joint" type="fixed">
        <parent link="right_shoulder"/>
        <child link="right_upper_arm"/>
        <origin xyz="0 0 -${upper_arm_length/2}" rpy="0 0 0"/>
    </joint>

    <link name="right_upper_arm">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${upper_arm_radius}" length="${upper_arm_length}"/>
            </geometry>
            <material name="light_grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${upper_arm_radius}" length="${upper_arm_length}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${upper_arm_mass}" length="${upper_arm_length}" radius="${upper_arm_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="right_upper_arm">
        <material>Gazebo/LightGrey</material>
        <self_collide>false</self_collide>
    </gazebo>

    <!-- Right Elbow Joint -->
    <joint name="right_elbow_joint" type="revolute">
        <parent link="right_upper_arm"/>
        <child link="right_forearm"/>
        <origin xyz="0 0 -${upper_arm_length/2}" rpy="0.235 0 0"/>
        <!-- Axis reversed on 2026-08-25. The physical elbow moved correctly
             for a given command while RViz rendered its mirror image, from the
             SAME /joint_states sample - an objective URDF-vs-hardware
             disagreement, not a matter of expectation. Gazebo agreed with RViz
             because both read this file. Fixed here rather than by re-adding
             elbow IDs (4, 11) to isServoInverted(), which would have made RViz
             match by breaking the real arm.
             Firmware v2.1 (2026-09-05) re-signed the wire convention from
             -0.873..0 to 0..0.785 rad (45 deg) - same physical travel, opposite
             sign for the same bend. Rotation(axis, angle) == Rotation(-axis,
             -angle), so to keep the physical direction unchanged under the new
             positive-angle convention the axis is negated a second time here
             (rather than re-adding a sign flip in esp_hardware_interface.cpp,
             which forwards joint values to the wire verbatim - see
             isServoInverted()), and the limit flips to 0..0.785 to match. -->
        <axis xyz="0 -0.9725 0.2328"/>
        <limit lower="0" upper="0.785" effort="5.0" velocity="2.0"/>
        <dynamics damping="0.5" friction="0.1"/>
    </joint>

    <link name="right_forearm">
        <visual>
            <origin xyz="0.0055 0 -${forearm_length/2}" rpy="0 -0.085 0"/>
            <geometry>
                <cylinder radius="${forearm_radius}" length="${forearm_length}"/>
            </geometry>
            <material name="light_grey"/>
        </visual>
        <collision>
            <origin xyz="0 0 -${forearm_length/2}" rpy="0 0 0"/>
            <geometry>
                <cylinder radius="${forearm_radius}" length="${forearm_length}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${forearm_mass}" length="${forearm_length}" radius="${forearm_radius}">
            <origin xyz="0 0 -${forearm_length/2}" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="right_forearm">
        <material>Gazebo/LightGrey</material>
        <self_collide>false</self_collide>
    </gazebo>

    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    <!-- Visual-only colored mesh attached to right forearm (converted from right-forearm.glb) -->
    <joint name="external_right_forearm_mesh_joint" type="fixed">
        <parent link="right_forearm"/>
        <child link="external_right_forearm_mesh_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="external_right_forearm_mesh_link">
        <visual>
            <origin xyz="0.005 0.0125 -0.00275" rpy="0.1 0.115 1.5708"/>
            <geometry>
                <mesh filename="package://bonicbot_a2_description/meshes/right-forearm.obj"/>
            </geometry>
        </visual>
    </link>
    <!-- +++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++ -->
    
    <!-- Visual-only colored mesh attached to body (converted from body.glb) -->
    <joint name="external_body_mesh_joint" type="fixed">
        <parent link="body"/>
        <child link="external_body_mesh_link"/>
        <origin xyz="0 0 0" rpy="0 0 ${pi/2}"/>
    </joint>

    <link name="external_body_mesh_link">
        <visual>
            <origin xyz="0 -0.0125 -0.225" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://bonicbot_a2_description/meshes/body.obj"/>
            </geometry>
        </visual>
    </link>
</robot>

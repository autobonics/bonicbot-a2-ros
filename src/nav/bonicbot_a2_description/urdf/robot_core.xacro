<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:include filename="inertial_macros.xacro"/>

    <!-- ========================================= -->
    <!-- Humanoid Body Component Properties -->
    <!-- ========================================= -->
    
    <!-- Body Properties -->
    <xacro:property name="body_length" value="0.180"/>
    <xacro:property name="body_width" value="0.13"/>
    <xacro:property name="body_height" value="0.36"/>
    <xacro:property name="body_mass" value="5.0"/>
    
    <!-- Shoulder Properties -->
    <xacro:property name="shoulder_radius" value="0.025"/>
    <xacro:property name="shoulder_length" value="0.080"/>
    <xacro:property name="shoulder_mass" value="0.3"/>
    
    <!-- Upper Arm Properties -->
    <xacro:property name="upper_arm_radius" value="0.01"/>
    <xacro:property name="upper_arm_length" value="0.12"/>
    <xacro:property name="upper_arm_mass" value="0.2"/>
    
    <!-- Forearm Properties -->
    <xacro:property name="forearm_radius" value="0.0115"/>
    <xacro:property name="forearm_length" value="0.125"/>
    <xacro:property name="forearm_mass" value="0.15"/>

    <!-- Gripper Properties -->
    <xacro:property name="gripper_palm_length" value="0.0335"/>
    <xacro:property name="gripper_palm_width" value="0.05"/>
    <xacro:property name="gripper_palm_height" value="0.03"/>
    <xacro:property name="gripper_palm_mass" value="0.05"/>
    <xacro:property name="gripper_finger_length" value="0.03"/>
    <xacro:property name="gripper_finger_width" value="0.00375"/>
    <xacro:property name="gripper_finger_height" value="0.004"/>
    <xacro:property name="gripper_finger_mass" value="0.01"/>
    <xacro:property name="gripper_finger_ext_length" value="0.0325"/>
    <xacro:property name="gripper_finger_ext_width" value="0.005025"/>
    <xacro:property name="gripper_finger_ext_height" value="0.00425"/>
    <xacro:property name="gripper_finger_ext_mass" value="0.01"/>


    <!-- Head/Neck Properties -->
    <xacro:property name="neck_radius" value="0.025"/>
    <xacro:property name="neck_length" value="0.05"/>
    <xacro:property name="neck_mass" value="0.1"/>
    <xacro:property name="head_radius" value="0.08"/>
    <xacro:property name="head_mass" value="0.3"/>

    <!-- ========================================= -->
    <!-- Chassis and Wheel Properties -->
    <!-- ========================================= -->

    <xacro:property name="chassis_length" value="0.228"/>
    <xacro:property name="chassis_width" value="0.22"/>
    <xacro:property name="chassis_height" value="0.0925"/>
    <xacro:property name="chassis_mass" value="10.0"/>
    <xacro:property name="wheel_radius" value="0.06"/>
    <xacro:property name="wheel_thickness" value="0.055"/>
    <xacro:property name="wheel_mass" value="0.5"/>
    <xacro:property name="wheel_offset_x" value="0.0"/>
    <xacro:property name="wheel_offset_y" value="0.14475"/>
    <xacro:property name="wheel_offset_z" value="0.064"/>
    <xacro:property name="caster_wheel_radius" value="0.0175"/>
    <xacro:property name="caster_wheel_mass" value="0.01"/>
    <xacro:property name="caster_wheel_offset_x_front" value="0.095"/>
    <xacro:property name="caster_wheel_offset_x_back" value="-0.095"/>
    <xacro:property name="caster_wheel_offset_z" value="${wheel_offset_z - wheel_radius + caster_wheel_radius}"/>

    <!-- Ground clearance & Z-chain parametric definitions -->
    <xacro:property name="chassis_ground_clearance" value="0.044"/>
    <xacro:property name="chassis_center_z_rel_chassis" value="${wheel_offset_z - wheel_radius + chassis_ground_clearance + (chassis_height/2)}"/>
    <xacro:property name="chassis_top_z_rel_chassis" value="${chassis_center_z_rel_chassis + (chassis_height/2)}"/>
    <xacro:property name="body_ground_gap" value="0.0555"/>
    <xacro:property name="pelvis_length" value="0.18"/>
    <xacro:property name="pelvis_z_center" value="0.06"/>
    <xacro:property name="body_joint_z_rel_chassis" value="${chassis_top_z_rel_chassis + body_ground_gap + (pelvis_length/2 - pelvis_z_center)}"/>

    <material name="white">
        <color rgba="1 1 1 1" />
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>

    <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1"/>
    </material>

    <material name="light_grey">
        <color rgba="0.7 0.7 0.7 1"/>
    </material>

    <!-- Include humanoid components after properties and materials are defined -->
    <xacro:include filename="body.xacro" />
    <xacro:include filename="head.xacro" />
    <xacro:include filename="gripper.xacro" />


    <link name="base_link">
    </link>


    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 -${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <link name="base_footprint">
    </link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="${-wheel_offset_x} 0 ${-wheel_offset_z}"/>
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="0 0 ${chassis_center_z_rel_chassis}"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 ${chassis_center_z_rel_chassis}"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="0 0 0.02" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <gazebo reference="chassis">
        <material>Gazebo/Orange</material>
    </gazebo>


    <!-- WHEEL MACRO -->
    <xacro:macro name="wheel" params="prefix reflect axis_z mesh_rpy">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <origin xyz="0 ${reflect * wheel_offset_y} 0" rpy="${-reflect * pi/2} 0 0" />
            <axis xyz="0 0 ${axis_z}"/>
            <limit effort="100.0" velocity="40.0"/>
            <dynamics damping="0.0" friction="0.0"/>
        </joint>

        <link name="${prefix}_wheel">
            <collision>
                <geometry>
                    <sphere radius="${wheel_radius}"/>
                </geometry>
            </collision>
            <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </xacro:inertial_cylinder>
        </link>

        <gazebo reference="${prefix}_wheel">
            <material>Gazebo/Black</material>
            <mu1 value="10.0"/>
            <mu2 value="10.0"/>
            <fdir1 value="1 0 0"/>
            <kp value="1e7"/>
            <kd value="1.0"/>
        </gazebo>

        <!-- Visual-only colored mesh attached to wheel (converted from ${prefix}-wheel.glb) -->
        <joint name="external_${prefix}_wheel_mesh_joint" type="fixed">
            <parent link="${prefix}_wheel"/>
            <child link="external_${prefix}_wheel_mesh_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </joint>

        <link name="external_${prefix}_wheel_mesh_link">
            <visual>
                <origin xyz="0.0 -0.06925 -0.1443" rpy="${mesh_rpy}"/>
                <geometry>
                    <mesh filename="package://bonicbot_a2_description/meshes/${prefix}-wheel.obj"/>
                </geometry>
            </visual>
        </link>
    </xacro:macro>

    <xacro:wheel prefix="left" reflect="1" axis_z="1" mesh_rpy="-${pi/2} -${pi/2} 0"/>
    <xacro:wheel prefix="right" reflect="-1" axis_z="-1" mesh_rpy="-${pi/2} ${pi/2} 0"/>


    <!-- FRONT CASTER WHEEL LINK -->

    <joint name="front_caster_wheel_joint" type="fixed">
        <parent link="chassis"/>
        <child link="front_caster_wheel"/>
        <origin xyz="${caster_wheel_offset_x_front} 0 ${caster_wheel_offset_z}"/>
    </joint>


    <link name="front_caster_wheel">
        <collision>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="${caster_wheel_mass}" radius="${caster_wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>

    <gazebo reference="front_caster_wheel">
        <material>Gazebo/White</material>
        <mu1 value="0.0"/>
        <mu2 value="0.0"/>
        <kp value="1e7"/>
        <kd value="1.0"/>
    </gazebo>


    <!-- BACK CASTER WHEEL LINK -->

    <joint name="back_caster_wheel_joint" type="fixed">
        <parent link="chassis"/>
        <child link="back_caster_wheel"/>
        <origin xyz="${caster_wheel_offset_x_back} 0 ${caster_wheel_offset_z}"/>
    </joint>


    <link name="back_caster_wheel">
        <collision>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_sphere mass="${caster_wheel_mass}" radius="${caster_wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
    </link>

    <gazebo reference="back_caster_wheel">
        <material>Gazebo/White</material>
        <mu1 value="0.0"/>
        <mu2 value="0.0"/>
        <kp value="1e7"/>
        <kd value="1.0"/>
    </gazebo>

    <!-- ===== IMU Link ===== -->
    <!-- Fixed to base_link — matches frame_id 'imu_link' in sensor_msgs/Imu -->
    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>

    <link name="imu_link">
        <visual>
            <geometry>
                <box size="0.02 0.02 0.01"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <visualize>true</visualize>
            <topic>/imu/data</topic>
            <gz_frame_id>imu_link</gz_frame_id>
            <imu>
                <angular_velocity>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>2e-4</stddev>
                            <bias_mean>0.0000075</bias_mean>
                            <bias_stddev>0.0000008</bias_stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>2e-4</stddev>
                            <bias_mean>0.0000075</bias_mean>
                            <bias_stddev>0.0000008</bias_stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>2e-4</stddev>
                            <bias_mean>0.0000075</bias_mean>
                            <bias_stddev>0.0000008</bias_stddev>
                        </noise>
                    </z>
                </angular_velocity>
                <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>1.7e-2</stddev>
                            <bias_mean>0.1</bias_mean>
                            <bias_stddev>0.001</bias_stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>1.7e-2</stddev>
                            <bias_mean>0.1</bias_mean>
                            <bias_stddev>0.001</bias_stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>1.7e-2</stddev>
                            <bias_mean>0.1</bias_mean>
                            <bias_stddev>0.001</bias_stddev>
                        </noise>
                    </z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

</robot>
<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bonicbot_a2_description</name>
  <version>1.0.0</version>
  <description>
    BonicBot A2 URDF/xacro description and meshes. Shared by the real robot
    (ros2_control binds the ESP hardware interface) and Gazebo simulation
    (ros2_control binds gz_ros2_control), selected by the sim_mode xacro arg.
  </description>
  <maintainer email="autobonics@gmail.com">Autobonics</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

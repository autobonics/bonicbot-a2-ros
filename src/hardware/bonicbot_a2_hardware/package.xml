<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bonicbot_a2_hardware</name>
  <version>1.0.0</version>
  <description>
    BonicBot A2 hardware layer — owns every /dev/* device on the robot.
    Contains the ros2_control SystemInterface plugin that drives the ESP32-S3
    over USB CDC (wheels, servos, IMU, battery, Wi-Fi relay), plus the RPLIDAR
    and CSI camera drivers.
  </description>
  <maintainer email="autobonics@gmail.com">Autobonics</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- hardware interface plugin -->
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <!-- ros2_control stack brought up by hardware.launch.py -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <!-- throttle relay for /joint_states -> /joint_states_throttled, which is
       what robot_app subscribes to. See hardware.launch.py. -->
  <exec_depend>topic_tools</exec_depend>

  <!-- robot_description comes from the description package -->
  <exec_depend>bonicbot_a2_description</exec_depend>

  <!-- other /dev/* owners -->
  <exec_depend>rplidar_ros</exec_depend>
  <!-- libcamera, not v4l2_camera: unicam only streams the ov5647's native
       10-bit Bayer (GB10), which v4l2_camera cannot consume — every other
       format fails STREAMON with "Failed to start media pipeline: -22".
       camera_ros drives libcamera, which routes Bayer through the bcm2835-isp
       hardware ISP. See camera.launch.py. -->
  <exec_depend>camera_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/bonicbot_a2_hardware.xml"/>
  </export>
</package>

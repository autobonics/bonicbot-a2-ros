# Source dependencies built in this workspace instead of installed from apt.
#
# Import into src/external/ (gitignored, never committed):
#     vcs import src/external < external.repos
# or by hand: git clone <url> src/external/<name> && git -C ... checkout <version>
#
# rplidar_ros: Jazzy's apt package (ros-jazzy-rplidar-ros 2.1.0) bundles
# Slamtec's old SDK 1.12, which cannot start an RPLIDAR C1 scan ("Cannot start
# scan: 80008000", seen on the A2 Pi 5, 2026-10-12). It is built from an older
# third-party fork, and Slamtec has said no newer Jazzy release is coming soon
# (github.com/Slamtec/rplidar_ros/issues/164). C1 support is on Slamtec's ros2
# branch (commit 70d91854, 2023-10-31). Pinned to that branch's latest commit,
# which also carries the newer-compiler build fix. NOT the 2.1.5 tag: that tag
# is on Slamtec's ROS 1 branch. Drop this entry and go back to apt once a
# Jazzy release with C1 support is published.
#
# libcamera + camera_ros: the Pi 5's camera path (rp1-cfe + PiSP) is driven by
# libcamera's rpi/pisp pipeline, which looks the receiver's video nodes up by
# name. Raspberry Pi's kernel (Ubuntu's raspi kernel included) names them
# `rp1-cfe-fe_image0`; upstream libcamera, which ros-jazzy-libcamera is built
# from, expects mainline's `rp1-cfe-fe-image0`, so it finds no camera at all
# ("Unable to acquire a CFE instance", seen on the A2 Pi 5, 2026-10-23).
# Raspberry Pi's fork matches their kernel. camera_ros's README gives building
# that fork in the workspace as the only way to use it on Ubuntu. Pinned to
# release v0.7.2+rpt20260817 (same 0.7.2 base as the ROS package), and
# camera_ros to 0.7.0 (the version the apt package was). camera_ros is built
# here too because the apt camera_ros depends on ros-jazzy-libcamera.
# NOT rpt20261009: it deprecates libcamera::Span (as upstream's main branch
# does), and camera_ros 0.7.0 builds with -Werror, so it fails to compile.
# Move both together once a camera_ros release uses std::span.
# Drop both entries and go back to apt (ros-jazzy-camera-ros) once the apt
# libcamera finds the Pi 5 camera: with the apt packages installed, run
# `ros2 run camera_ros camera_node` on a Pi 5 and check for "Registered camera
# ... rpi/pisp" instead of "no cameras available". That happens when either
# upstream libcamera accepts Raspberry Pi's node names, or the Pi's kernel
# switches to mainline's.
# libcamera fetches its libpisp subproject (subprojects/libpisp.wrap, v1.5.0)
# at configure time unless subprojects/libpisp is already there.
repositories:
  rplidar_ros:
    type: git
    url: https://github.com/Slamtec/rplidar_ros.git
    version: 24cc9b6dea97e045bda1408eaa867ce730fd3fc3
  libcamera:
    type: git
    url: https://github.com/raspberrypi/libcamera.git
    version: 6c1dd9d55573010f710c9e190a73e7e76f0d9432
  camera_ros:
    type: git
    url: https://github.com/christianrauch/camera_ros.git
    version: f4023dc09cfc5fd36fedbb3656ad3a98733e297a
